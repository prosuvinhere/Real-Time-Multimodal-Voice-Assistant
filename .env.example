# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Simulation / Mock Mode (set to true to test locally without live API keys)
MOCK_APIS=true

# Automatic Speech Recognition (ASR) - Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_ENDPOINTING_MS=300

# Reasoning LLM - OpenAI / Groq / Anthropic / Fast API
OPENAI_API_KEY=your_openai_or_groq_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_SYSTEM_PROMPT="You are a helpful, lightning-fast voice assistant. Respond concisely in 1-2 short sentences without bullet points or complex markdown."

# Text-to-Speech (TTS) - ElevenLabs / Cartesia
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# Cartesia Alternative (optional)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Latency Budget Budgets (in milliseconds)
BUDGET_ASR_MS=350
BUDGET_LLM_TTFT_MS=250
BUDGET_TTS_TTFB_MS=150
BUDGET_TOTAL_PERCEIVED_MS=800

# Timeouts & Resilience (in seconds)
TIMEOUT_ASR_SILENCE_SEC=5.0
TIMEOUT_LLM_TTFT_SEC=1.5
TIMEOUT_TTS_TTFB_SEC=1.0
CIRCUIT_BREAKER_FAILURES_THRESHOLD=3
FALLBACK_AUDIO_FILE=static/fallback_trouble_connecting.wav
